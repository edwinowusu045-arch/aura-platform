            <a href="#features" className="hover:text-[#C9A96E] transition-colors">Features</a>
            <a href="#insights" className="hover:text-[#C9A96E] transition-colors">Insights</a>
            <Link href="/pricing" className="hover:text-[#C9A96E] transition-colors">Pricing</Link>
          </div>
          <button className="md:hidden text-[#0A0A0A]">
            <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
        </nav>
